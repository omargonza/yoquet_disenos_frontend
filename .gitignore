# ================================
# ⚙️ CONFIGURACIÓN GENERAL
# ================================

# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos de build / compilación
dist/
build/
.cache/
.tmp/
# PWA dev output
dev-dist/

# PWA artifacts (si alguna vez se generan sueltos)
sw.js
sw.js.map
workbox-*.js
workbox-*.js.map

# Archivos del editor / sistema
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# Archivos de entorno (no subir claves)
.env
.env.local
.env.*.local
.env.prod
.env.example


# Archivos de lock alternativos (opcional)
package-lock.json
pnpm-lock.yaml
yarn.lock

# Logs
*.log
logs/
*.log.*
log.txt

# Archivos temporales
*.tmp
*.bak
*.swp
*.swp.*
*.orig

# ================================
# 🚀 DEPLOY / HOSTING
# ================================

# Carpetas generadas por build (Render genera su propio dist)
dist/
out/
coverage/
.cache/

# Archivos de GitHub Pages (si los tuviste antes)
.deploy/
gh-pages/
